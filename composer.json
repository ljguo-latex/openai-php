{
    "name": "ljguo/openai-php",
    "description": "A PHP client for the OpenAI API with support for custom URL, API key, and model.",
    "type": "library",
    "keywords": ["openai", "api", "client", "gpt", "ai", "llm", "chat"],
    "homepage": "https://github.com/ljguo/openai-php",
    "license": "MIT",
    "authors": [
        {
            "name": "ljguo",
            "email": "ljguo1020@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Ljguo\\OpenAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ljguo\\OpenAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
